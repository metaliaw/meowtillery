# Caché de Godot 4 (se regenera al abrir el proyecto)
.godot/
*.import

# Juegos exportados (se regeneran con Godot: Project > Export)
build/*
!build/.gdignore

# Grabaciones originales (personales). Solo los recortes elegidos pasan a assets/sonidos/.
grabaciones/

# Dedicatoria del regalo (lleva un nombre: va en el zip de Windows, no en GitHub ni en la web).
data/dedicatoria.json
